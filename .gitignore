# ──────────────────────────────────────────────
#  CUSTECH CBT System — .gitignore
# ──────────────────────────────────────────────

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
venv/
venv_new/
.venv/
.ci_venv/
env/
ENV/
test_env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.xml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyright / Pyrefly
.pyright/
pyrightconfig.json
.pyrefly/

# ── Environment & Secrets ────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ── Database ─────────────────────────────────
*.db
*.sqlite
*.sqlite3
cbt_test.db
dump.rdb

# ── Logs ─────────────────────────────────────
logs/
*.log
*.log.*

# ── Uploads / media ──────────────────────────
uploads/
media/

# ── Node / Frontend ──────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
frontend/.vite/
*.tsbuildinfo

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── IDEs & Editors ───────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Local dev stack (manual testing scripts) ─
.local/

# ── Docker ───────────────────────────────────
*.dockerenv
docker-compose.override.yml

# ── OS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Temporary / scratch files ────────────────
fix_*.py
remove_*.py
test_login.py
seed_*.py.bak
*.bak
*.tmp
*.temp

# ── Python bytecode cache ────────────────────
src/**/__pycache__/
src/**/*.pyc
