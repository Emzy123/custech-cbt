# ──────────────────────────────────────────────────────────────
#  CUSTECH CBT System — Environment Variables Example
#  Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Database (MongoDB) ────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=cbt_db
DATABASE_USER=
DATABASE_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=cbt-system
JWT_AUDIENCE=cbt-users

# ── Application ───────────────────────────────────────────────
APP_NAME=CBT System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@custech.edu.ng
# Required only when running seed_admin.py
SEED_ADMIN_PASSWORD=

# ── Security ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SECRET_KEY=CHANGE_ME_another_long_random_key
RANDOMISATION_SECRET=CHANGE_ME_exam_randomisation_server_secret

# ── Biometric ────────────────────────────────────────────────
BIOMETRIC_ENCRYPTION_KEY=CHANGE_ME_must_be_at_least_32_characters_long
FINGERPRINT_THRESHOLD=85.0
FACIAL_THRESHOLD=80.0
VOICE_THRESHOLD=75.0

# ── Email (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@custech.edu.ng
EMAIL_FROM_NAME=CBT System

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=["pdf","doc","docx","csv","txt"]

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/cbt.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ── Session ──────────────────────────────────────────────────
SESSION_COOKIE_NAME=cbt_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_MINUTES=120
IDLE_TIMEOUT_MINUTES=30

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# ── Health & Metrics ─────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
